# ===================================================
# .env.example — Online Grocery Ordering System
# ===================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file — it is listed in .gitignore.
#
# For local development, set these values in your shell or
# create a .env file at the project root (it is gitignored).
#
# For Docker deployment, pass these as environment variables
# in docker-compose.yml (see docker-compose.yml for usage).
# ===================================================

# ── Database ──────────────────────────────────────
# MySQL server credentials used by the Spring Boot backend.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=online_grocery_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# ── JWT ───────────────────────────────────────────
# A 256-bit (32-byte) secret key (Base64-encoded).
# Generate a secure key with:  openssl rand -base64 32
JWT_SECRET=replace_with_your_own_secure_key_do_not_use_this_value
JWT_EXPIRATION_MS=86400000

# ── CORS ─────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
# For local dev & Docker: http://localhost:5173,http://localhost:3000
# For production: https://your-app.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Server ────────────────────────────────────────
SERVER_PORT=8080

# ── Demo Account Seeding (Optional) ───────────────
# Passwords for automatically provisioning initial demo accounts on first launch.
# If these variables are omitted or left blank, demo account seeding is skipped.
# Minimum 8 characters recommended.
SEED_ADMIN_PASSWORD=your_secure_admin_password_here
SEED_CUSTOMER_PASSWORD=your_secure_customer_password_here
SEED_VENDOR_PASSWORD=your_secure_vendor_password_here
# Optional per-vendor overrides (defaults to SEED_VENDOR_PASSWORD if unset):
# SEED_VENDOR1_PASSWORD=your_secure_vendor1_password_here
# SEED_VENDOR2_PASSWORD=your_secure_vendor2_password_here
